    "html": "<html lang=\"tr-TR\"><head><base href=\"/\"><meta charset=\"utf-8\"><meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0\">\n<title>İletişim</title><meta name=\"description\" content=\"İletişim\">\n\t<link rel=\"shortcut icon\" href=\"panel/galeri/favicon.ico\">\n<script src=\"//ajax.googleapis.com/ajax/libs/jquery/2.0.0/jquery.min.js\"></script><link href=\"css/bootstrap.min.css\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"style.php?v=2\" media=\"all\">\n<link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.6.3/css/font-awesome.css\" rel=\"stylesheet\">\n<script src=\"js/bootsnav.js\"></script>\n<script src=\"js/bootstrap.min.js\"></script>\n<link href=\"https://cdnjs.cloudflare.com/ajax/libs/animate.css/3.5.2/animate.min.css\" rel=\"stylesheet\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Roboto+Flex:wght@400;600&amp;display=swap\" rel=\"stylesheet\">\n\n<link rel=\"canonical\" href=\"https://demo1.maxiweb.com.tr/tr/iletisim\"><script>$(document).ready(function(){if(window.location.pathname=='/'){$('body').addClass('home')}else{$('body').addClass('other')}});</script>\n<script>function handleResize(){if(window.innerWidth>992&&window.location.pathname=='/'){$('.logo').attr('src','panel/galeri/logo.png')}else{$('.logo').attr('src','panel/galeri/logo.png')}}\n$(document).ready(function(){handleResize();$(window).resize(handleResize);if(window.location.pathname=='/'&&window.innerWidth>992){$('.logo').attr('src','panel/galeri/logo.png')}else{$('.logo').attr('src','panel/galeri/logo.png')}});$(window).scroll(function(){if(window.innerWidth>992&&window.location.pathname=='/'){if($(this).scrollTop()>100){$('.logo').attr('src','panel/galeri/logo.png')}else{$('.logo').attr('src','panel/galeri/logo.png')}}});</script>\n<script>$(window).scroll(function(){if($(this).scrollTop()>100){$('.teststicky').addClass('sticky')}else{$('.teststicky').removeClass('sticky')}});</script><script>$(document).ready(function(){$(\"#div1\").fadeIn();$(\"#div2\").fadeIn();$(\"#div2\").fadeIn(\"slow\");$(\"#div3\").fadeIn(50)});</script><script>$('#but').click(function(e){e.stopPropagation()});$(\"#but\").click(function(e){e.preventDefault();e.stopPropagation();$('#myDropdownmob').show()});$('#butm').click(function(e){e.stopPropagation()});$(\"#butm\").click(function(e){e.preventDefault();e.stopPropagation();$('#myDropdownmob').show()});$(\"#myInput\").click(function(e){e.preventDefault();e.stopPropagation();$('#myDropdown').show();$('#myDropdownmob').show()});$(\"#ara\").click(function(e){e.preventDefault();e.stopPropagation();$('#myDropdownmob').show()});$(document).click(function(){$('#myDropdown').hide(250);$('#myDropdownmob').hide(250)});</script>\n</head><body>\n\n<style>\n  .teststicky {\n    top: 35px !important;  \n}\n.topbar {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    background: #000000 !important;\n    color: #ffffff !important;\n\n    z-index: 9999;\n    height: 35px; /* bar yüksekliği */\n    padding-top: 4px;\n}\n.topbar a {\n \n    color: #ffffff !important;\n }\n\n .bg-blue{background: #2a5c81 !important;\n  color: #ffffff !important;}\n   .bg-green{background: #68582b !important;\n  color: #ffffff !important;}\n  .h-blue{color: #2a5c81 !important;}\n  .bg-blue2{background-color: #1e3944 !important;\n    color: #ffffff !important;}\n      .bg-blue3{background-color: #162c35 !important;\n    color: #ffffff !important;}\n  .bg-bluefooter{background-color: #1d405a !important;}\n  .h-white{color: #ffffff !important;}\n</style>\n\n<div class=\"container-full topbar bg-blue3\"> <span style=\" float: right; text-align: right; \"> \n<a target=\"_blank\" href=\"https://www.instagram.com/adilhukukdanismanlikhizmetleri/\" rel=\"nofollow\" style=\"margin-left: 4px; margin-right: 4px;\"><i class=\"fa fa-instagram fsize\"></i></a> \n<a target=\"_blank\" href=\"https://x