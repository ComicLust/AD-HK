    "html": "<html lang=\"tr\"><head><meta charset=\"utf-8\"><meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0\"><title>Adil Hukuk Danışmanlık Hizmetleri</title><meta name=\"description\" content=\"Adil Hukuk Danışmanlık Hizmetleri\"><link rel=\"shortcut icon\" href=\"panel/galeri/favicon.ico\">\n<script src=\"//ajax.googleapis.com/ajax/libs/jquery/2.0.0/jquery.min.js\"></script><link href=\"css/bootstrap.min.css\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"style.php?v=2\" media=\"all\">\n<link href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.6.3/css/font-awesome.css\" rel=\"stylesheet\">\n<script src=\"js/bootsnav.js\"></script>\n<script src=\"js/bootstrap.min.js\"></script>\n<link href=\"https://cdnjs.cloudflare.com/ajax/libs/animate.css/3.5.2/animate.min.css\" rel=\"stylesheet\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Roboto+Flex:wght@400;600&amp;display=swap\" rel=\"stylesheet\">\n\n<link rel=\"canonical\" href=\"https://demo1.maxiweb.com.tr/\"><script>$(document).ready(function(){if(window.location.pathname=='/'){$('body').addClass('home')}else{$('body').addClass('other')}});</script>\n<script>function handleResize(){if(window.innerWidth>992&&window.location.pathname=='/'){$('.logo').attr('src','panel/galeri/logo.png')}else{$('.logo').attr('src','panel/galeri/logo.png')}}\n$(document).ready(function(){handleResize();$(window).resize(handleResize);if(window.location.pathname=='/'&&window.innerWidth>992){$('.logo').attr('src','panel/galeri/logo.png')}else{$('.logo').attr('src','panel/galeri/logo.png')}});$(window).scroll(function(){if(window.innerWidth>992&&window.location.pathname=='/'){if($(this).scrollTop()>100){$('.logo').attr('src','panel/galeri/logo.png')}else{$('.logo').attr('src','panel/galeri/logo.png')}}});</script>\n<script>$(window).scroll(function(){if($(this).scrollTop()>100){$('.teststicky').addClass('sticky')}else{$('.teststicky').removeClass('sticky')}});</script><script>$(document).ready(function(){$(\"#div1\").fadeIn();$(\"#div2\").fadeIn();$(\"#div2\").fadeIn(\"slow\");$(\"#div3\").fadeIn(50)});</script><script>$('#but').click(function(e){e.stopPropagation()});$(\"#but\").click(function(e){e.preventDefault();e.stopPropagation();$('#myDropdownmob').show()});$('#butm').click(function(e){e.stopPropagation()});$(\"#butm\").click(function(e){e.preventDefault();e.stopPropagation();$('#myDropdownmob').show()});$(\"#myInput\").click(function(e){e.preventDefault();e.stopPropagation();$('#myDropdown').show();$('#myDropdownmob').show()});$(\"#ara\").click(function(e){e.preventDefault();e.stopPropagation();$('#myDropdownmob').show()});$(document).click(function(){$('#myDropdown').hide(250);$('#myDropdownmob').hide(250)});</script>\n</head><body>\n\n<style>\n  .teststicky {\n    top: 35px !important;  \n}\n.topbar {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    background: #000000 !important;\n    color: #ffffff !important;\n\n    z-index: 9999;\n    height: 35px; /* bar yüksekliği */\n    padding-top: 4px;\n}\n.topbar a {\n \n    color: #ffffff !important;\n }\n\n .bg-blue{background: #2a5c81 !important;\n  color: #ffffff !important;}\n   .bg-green{background: #68582b !important;\n  color: #ffffff !important;}\n  .h-blue{color: #2a5c81 !important;}\n  .bg-blue2{background-color: #1e3944 !important;\n    color: #ffffff !important;}\n      .bg-blue3{background-color: #162c35 !important;\n    color: #ffffff !important;}\n  .bg-bluefooter{background-color: #1d405a !important;}\n  .h-white{color: #ffffff !important;}\n</style>\n\n<div class=\"container-full topbar bg-blue3\"> <span style=\" float: right; text-align: right; \"> \n<a target=\"_blank\" href=\"https://www.instagram.com/adilhukukdanismanlikhizmetleri/\" rel=\"nofollow\" style=\"margin-left: 4px; margin-right: 4px;\"><i class=\"fa fa-instagram fsize\"></i></a> \n<a target=\"_blank\" href=\"https://x.com/adilhukuknet\" rel=\"nofollow\" style=\"margin-left: 4px; margin-right: 4px;\"><i class=\"fa fa-twitter fsize\"></i></a>\n<a target=\"_blank\" href=\"https://www.youtube.com/@adilhukuk\" rel=\"nofollow\" style=\"margin-left: 4px; margin-right: 4px;\"><i class=\"fa fa-youtube fsize\"></i></a>\n<a target=\"_blank\" href=\"https://www.facebook.com/profile.php?id=61580900027911\" rel=\"nofollow\" style=\"margin-left: 4px; margin-right: 4px; \"><i class=\"fa fa-facebook fsize\"></i></a>\n<a target=\"_blank\" href=\"https://www.linkedin.com\" rel=\"nofollow\" style=\"margin-left: 4px; margin-right: 4px;\"><i class=\"fa fa-linkedin fsize\"></i></a>\n<a target=\"_blank\" href=\"https://wa.me/905317760283\" rel=\"nofollow\" style=\"margin-left: 4px; margin-right: 4px; \"><i class=\"fa fa-whatsapp fsize\"></i></a>\n<a target=\"_blank\" href=\"https://www.linkedin.com\" rel=\"nofollow\" style=\"margin-left: 4px; margin-right: 4px; display: none;\"><i class=\"fa fa-wordpress fsize\"></i></a>\n\n<select class=\"selectpicker\" onchange=\"location = this.value;\" aria-label=\"language\" style=\"border:1px solid #eeeeee; margin-left: 4px; margin-right: 10px;\"> <option value=\"/\">TR</option> <option value=\"/en\">EN</option> </select> </span> </div>\n\n<div class=\"teststicky relative\">\n\n \n<nav class=\"navbar  bootsnav navbar menuarka container-urun \">\n    <div class=\"container-menu\"> \n <div class=\"navbar-header \">\n<div class=\"attr-nav\"> <ul><li class=\"side-menu s8\"><div class=\"kutu\"><button type=\"button\" class=\"navbar-toggle\" aria-label=\"toggle\" data-toggle=\"collapse\" data-target=\"#navbar-menu\"> <i class=\"fa fa-bars menu5\"></i></button> </div></li> </ul> </div>  </div> \n<div class=\"navbar-brand\" id=\"div3\" style=\"display: none;\">\n<a href=\"/\" rel=\"canonical\"><img class=\"logo \" src=\"panel/galeri/logo.png\" alt=\"logo\"></a>\n</div>\n  <div class=\"collapse navbar-collapse menu6\" id=\"navbar-menu\">  \n    <ul class=\"nav navbar-nav navbar-center \" id=\"div1\" style=\"display: none;\">\n    <script>$(function(){$(\"#drop401\").click(function(){$(\"#dropdown-menu401\").toggle()})});</script>\n  <li class=\"visible-sm visible-lg visible-xs hidden-md  active  \"><a href=\"https://demo1.maxiweb.com.tr\" rel=\"canonical\">\nAnasayfa  </a></li><script>$(function(){$(\"#drop996\").click(function(){$(\"#dropdown-menu996\").toggle()})});</script>\n<li class=\"dropdown       \"><a href=\"#\" data-toggle=\"dropdown\" id=\"drop996\">Kurumsal <i class=\"fa fa-caret-down\" aria-hidden=\"true\"></i>\n</a><ul class=\"dropdown-menu animated fadeIn mainmenu dropdown-toggle\" id=\"dropdown-menu996\">\n  <li><a href=\"tr/hakkimizda\">• Hakkımızda</a></li>\n   <li><a href=\"tr/kisisel-verilerin-korunmasi\">• Kişisel Verilerin Korunması</a></li>\n   <li><a href=\"tr/cerez-politikasi\">• Çerez Politikası</a></li>\n      \n </ul></li>\n<script>$(function(){$(\"#drop1304\").click(function(){$(\"#dropdown-menu1304\").toggle()})});</script>\n<li><a rel=\"canonical\" href=\"tr/ekibimiz\">Ekibimiz</a></li><script>$(function(){$(\"#drop1168\").click(function(){$(\"#dropdown-menu1168\").toggle()})});</script>\n<li><a rel=\"canonical\" href=\"tr/hizmetlerimiz\">Hizmetlerimiz</a></li><script>$(function(){$(\"#drop1248\").click(function(){$(\"#dropdown-menu1248\").toggle()})});</script>\n<li class=\"dropdown             \"><a href=\"#\" data-toggle=\"dropdown\" id=\"drop1248\">Haberler <i class=\"fa fa-caret-down\" aria-hidden=\"true\"></i>\n</a><ul class=\"dropdown-menu animated fadeIn mainmenu dropdown-toggle\" id=\"dropdown-menu1248\">\n  <li><a href=\"tr/haberler\">• Haberler</a></li>\n   <li><a href=\"tr/basinda-biz\">• Basında Biz</a></li>\n   <li><a href=\"tr/makaleler\">• Makaleler</a></li>\n   <li><a href=\"tr/etkinlikler\">• Etkinlikler</a></li>\n   <li><a href=\"tr/videolar\">• Videolar</a></li>\n   <li><a href=\"tr/bultenler\">• Bültenler</a></li>\n      \n </ul></li>\n<script>$(function(){$(\"#drop402\").click(function(){$(\"#dropdown-menu402\").toggle()})});</script>\n<li><a rel=\"canonical\" href=\"tr/iletisim\">Bize Ulaşın</a></li><script>$(function(){$(\"#drop1302\").click(function(){$(\"#dropdown-menu1302\").toggle()})});</script>\n<li><a rel=\"canonical\" href=\"tr/bize-katilin\">Bize Katılın</a></li></ul></div></div></nav></div><div class=\"clearfix\"></div><div id=\"bootstrap-touch-slider\" class=\"container-full carousel bs-slider fade  control-round indicators-line\" data-ride=\"carousel\" data-pause=\"none\" data-interval=\"5000\"><div class=\"carousel-inner\" role=\"listbox\">\n        <div class=\"item active\"><img src=\"panel/galeri/-1-4501784.jpg\" alt=\"1\" class=\"slide-image\"><a href=\"tr/iletisim\"><div class=\"bs-slider-overlay\"></div></a><div class=\"slide-text slide_style_center\"><h3 data-animation=\"animated fadeIn\" class=\"\"></h3></div></div></div><a class=\"left carousel-control\" href=\"#bootstrap-touch-slider\" role=\"button\" data-slide=\"prev\"><span class=\"fa fa-angle-left\" aria-hidden=\"true\"></span><span class=\"sr-only\">Previous</span></a><a class=\"right carousel-control\" href=\"#bootstrap-touch-slider\" role=\"button\" data-slide=\"next\"><span class=\"fa fa-angle-right\" aria-hidden=\"true\"></span><span class=\"sr-only\">Next</span></a></div><div class=\"container-full container-full-top\">    <div class=\"elementor-column elementor-col-50 elementor-inner-column elementor-element elementor-element-3e75e93\" data-id=\"3e75e93\" data-element_type=\"column\"><div class=\"elementor-widget-wrap elementor-element-populated\"><div class=\"elementor-element elementor-element-afe1f08 elementor-widget elementor-widget-sectiontitle\" data-id=\"afe1f08\" data-element_type=\"widget\" data-widget_type=\"sectiontitle.default\"><div class=\"elementor-widget-container\"><div class=\"section-title sayfa text-center\"><br><h1>Adil Hukuk Danışmanlık Bürosu</h1>\n                        <br><p class=\"section-text\" data-aos=\"fade-left\"></p></div><div class=\"section-title text-center\"><div class=\"row\"><div class=\"col-xs-12 col-sm-12\"></div></div></div></div></div></div></div></div>\n \n\n \n\n  \n \n<div class=\"container-urun\">\n  <div class=\"row\">\n    <!-- Card 1 -->\n    <div class=\"col-sm-4\">\n      <div class=\"service-card card-white bg-blue2\">\n        <i class=\"fa fa-line-chart\"></i>\n        <h2 class=\"h-white\">Hukuki Danışmanlık</h2>\n        <p class=\"h-white\">\nHukuki danışmanlık, birey ve şirketlerin haklarını korur, riskleri azaltır, güvenli adımlar atmalarını sağlar, olası kayıpların önüne geçer.</p>\n      </div>\n    </div>\n    <!-- Card 2 -->\n    <div class=\"col-sm-4\">\n      <div class=\"service-card card-light  bg-green\">\n        <i class=\"fa fa-user h-white\"></i>\n        <h2 class=\"h-white\">Sözleşmelerde Hukuki Destek</h2>\n        <p class=\"h-white\">Hazırlanan sözleşmeler tarafların haklarını güvenceye alır, ileride doğabilecek anlaşmazlıkları önler, güvenli ilişkiler oluşturur.</p>\n      </div>\n    </div>\n    <!-- Card 3 -->\n    <div class=\"col-sm-4\">\n      <div class=\"service-card card-gray\">\n        <i class=\"fa fa-bullseye h-white\"></i>\n        <h2 class=\"h-white\">Hukuki Süreçlerde Avukatın Rolü</h2>\n        <p class=\"h-white\">Avukat, hukuki süreçlerde haklarınızı en doğru şekilde savunur, usul hatalarını önler, süreci güvenle yönetir, adalet sağlar.</p>\n      </div>\n    </div>\n  </div>\n</div>\n \n<div class=\"container-urun hero-section\">\n  <div class=\"row\">\n    <!-- Left Text -->\n    <div class=\"col-md-8\"><br>\n      <h1 class=\"h-blue\">Stratejik yaklaşımlar</h1>\n      <p>Her biri alanında uzman hukukçulardan oluşan kadromuzla, hukukun gelişen dinamiklerine uyum sağlayarak, müvekkillerimizin artan ve çeşitlenen ihtiyaçlarına eksiksiz yanıt vermeye devam ediyoruz.<br><br>\nAlanında uzman ekibimizle, her bir dosyayı titizlikle inceleyerek müvekkillerimizin ihtiyaçlarına özel çözümler üretiyoruz. Hukukun tüm alanlarında güncel gelişmeleri yakından takip ediyor, süreç boyunca şeffaflık ve iletişimi ön planda tutuyoruz.<br><br>Amacımız, her koşulda müvekkillerimizin haklarını en güçlü şekilde korumak ve güven duyabilecekleri bir yol arkadaşlığı sunmaktır.\n      </p>\n\n      <div class=\"row stats\"><br>\n        <div class=\"col-xs-6\">\n     \n          <p>Güvenilir hukuki hizmet<br>sunuyoruz.</p>\n          <br>\n      <a href=\"tr/basinda-biz\"> <button class=\"btn btn-custom  bg-blue\">Basında Biz</button></a>\n        </div>\n        <div class=\"col-xs-6\">\n    \n          <p>Müvekkillerimizin karşılaştığı hukuki<br>sorunları çözüme kavuşturuyoruz.</p>\n          <br>\n      <a href=\"tr/ekibimiz\"> <button class=\"btn btn-custom  bg-blue\">Ekibimiz</button></a>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- Right Image -->\n    <div class=\"col-md-4 hero-img\">\n      <img src=\"img-02-510x680.jpg\" alt=\"Business Coach\">\n    </div>\n  </div>\n</div>\n\n \n<div class=\"container-urun services-section\" style=\"display: none;\">\n  <div class=\"row services-header\">\n    <div class=\"col-sm-12 section text-center\">\n      <h2 class=\" text-center h-blue\">Uzmanlık alanlarımız ve hizmetlerimiz</h2>\n      <p class=\" text-center\"></p>\n    </div>\n    <div class=\"col-sm-3 text-right\">\n\n    </div>\n  </div>\n\n  <div class=\"row\">\n    <!-- 1 -->\n    <div class=\"col-sm-4\">\n      <div class=\"service-box\">\n        <h2><i class=\"fa fa-long-arrow-right\"></i> Ticaret Hukuku</h2>\n        <p>Ticaretin hukuki güvence altında yürütülmesi, sürdürülebilir bir iş modeli ve kurumsal itibara giden yolun temelidir.</p>\n          <div class=\"col-sm-12 text-right\"><a href=\"tr/hizmetlerimiz/ticaret-hukuku\">\n      <button class=\"btn minibutton bg-blue\">Devamını Oku</button></a>\n    </div>\n      </div>\n     \n    </div>\n    <!-- 2 -->\n    <div class=\"col-sm-4\">\n      <div class=\"service-box\">\n        \n        <h2><i class=\"fa fa-long-arrow-right\"></i> Aile Hukuku</h2>\n        <p>Aile içi ilişkiler, hukuk düzeninin en hassas ve en çok yönlü müdahale alanlarından biridir.</p>   <div class=\"col-sm-12 text-right\">\n     <a href=\"tr/hizmetlerimiz/aile-hukuku\"><button class=\"btn minibutton bg-blue\">Devamını Oku</button></a>\n    </div>\n      </div>\n    </div>\n    <!-- 3 -->\n    <div class=\"col-sm-4\">\n      <div class=\"service-box\">\n        \n        <h2><i class=\"fa fa-long-arrow-right\"></i> Miras Hukuku</h2>\n        <p>Miras hukukunda yaşanan uyuşmazlıklar, aile bireyleri arasında telafisi güç kırılmalara neden olabilmektedir.</p>   <div class=\"col-sm-12 text-right\">\n      <a href=\"tr/hizmetlerimiz/miras-hukuku\"><button class=\"btn minibutton bg-blue\">Devamını Oku</button></a>\n    </div>\n      </div>\n    </div>\n\n    <div class=\"clearfix\"></div>\n    <!-- 4 -->\n    <div class=\"col-sm-4\">\n      <div class=\"service-box\">\n        \n        <h2><i class=\"fa fa-long-arrow-right\"></i>İcra ve İflas Hukuku</h2>\n        <p>Alacakların hızlı ve etkin bir şekilde tahsil edilmesi, ticari hayatta sürdürülebilirlik açısından büyük önem taşımaktadır.</p>   <div class=\"col-sm-12 text-right\">\n      <a href=\"tr/hizmetlerimiz/icra-ve-iflas-hukuku\"><button class=\"btn minibutton bg-blue\">Devamını Oku</button></a>\n    </div>\n      </div>\n    </div>\n    <!-- 5 -->\n    <div class=\"col-sm-4\">\n      <div class=\"service-box\">\n        \n        <h2><i class=\"fa fa-long-arrow-right\"></i> Ceza ve İnfaz Hukuku</h2>\n        <p>Ceza yargılaması, bireyin en temel hak ve özgürlüklerini doğrudan etkileyen bir alan olması nedeniyle titizlik ve yüksek sorumluluk taşır.</p>   <div class=\"col-sm-12 text-right\">\n      <a href=\"tr/hizmetlerimiz/ceza-ve-infaz-hukuku\"><button class=\"btn minibutton bg-blue\">Devamını Oku</button></a>\n    </div>\n      </div>\n    </div>\n    <!-- 6 -->\n    <div class=\"col-sm-4\">\n      <div class=\"service-box\">\n        \n        <h2><i class=\"fa fa-long-arrow-right\"></i>İdare Hukuku</h2>\n        <p>Kamu ile bireyler veya özel sektör arasındaki ilişkilerin hukuka uygun yürütülmesi, idari işlemlere karşı etkili başvuruyla mümkündür.</p>   <div class=\"col-sm-12 text-right\">\n      <a href=\"tr/hizmetlerimiz/idare-hukuku\"><button class=\"btn minibutton bg-blue\">Devamını Oku</button></a>\n    </div>\n      </div>\n    </div>\n<div class=\"clearfix\"></div>\n\n\n   <div class=\"col-sm-4\">\n      <div class=\"service-box\">\n        \n        <h2><i class=\"fa fa-long-arrow-right\"></i> İş ve Sosyal Güvenlik Hukuku</h2>\n        <p>İş hukuku, işçi ve işveren için bağlayıcı nitelik taşır ve ilişkileri düzenler.</p>   <div class=\"col-sm-12 text-right\">\n      <a href=\"tr/hizmetlerimiz/is-ve-sosyal-guvenlik-hukuku\"><button class=\"btn minibutton bg-blue\">Devamını Oku</button></a>\n    </div>\n      </div>\n    </div>\n\n     \n\n        <div class=\"col-sm-4\">\n      <div class=\"service-box\">\n        \n        <h2><i class=\"fa fa-long-arrow-right\"></i>Gayrimenkul ve İnşaat Hukuku</h2>\n        <p>Taşınmaz işlemleri, yüksek değeri ve kalıcı sonuçlarıyla uzmanlık gerektirir.</p>   <div class=\"col-sm-12 text-right\">\n      <a href=\"tr/hizmetlerimiz/gayrimenkul-ve-insaat-hukuku\"><button class=\"btn minibutton bg-blue\">Devamını Oku</button></a>\n    </div>\n      </div>\n    </div>\n\n        <div class=\"col-sm-4\">\n      <div class=\"service-box\">\n        \n        <h2><i class=\"fa fa-long-arrow-right\"></i>Fintek Hukuku</h2>\n        <p>Finansal teknolojilerdeki hızlı gelişmeler, dinamik ve sektörle uyumlu bir hukuk yaklaşımını gerektirir.</p>   <div class=\"col-sm-12 text-right\">\n      <a href=\"tr/hizmetlerimiz/fintek-hukuku\"><button class=\"btn minibutton bg-blue\">Devamını Oku</button></a>\n    </div>\n      </div>\n    </div>\n\n<div class=\"clearfix\"></div>\n\n        <div class=\"col-sm-4\">\n      <div class=\"service-box\">\n        \n        <h2><i class=\"fa fa-long-arrow-right\"></i>Bilişim Hukuku</h2>\n        <p>Günümüzde dijital teknolojilerin hayatımıza entegre olmasıyla birlikte, suçların da sanal ortama taşındığını görüyoruz.</p>   <div class=\"col-sm-12 text-right\">\n      <a href=\"tr/hizmetlerimiz/bilisim-hukuku\"><button class=\"btn minibutton bg-blue\">Devamını Oku</button></a>\n    </div>\n      </div>\n    </div>\n\n\n      <div class=\"col-sm-4\" style=\"display: none;\">\n      <div class=\"service-box\">\n        \n        <h2><i class=\"fa fa-long-arrow-right\"></i>Gerçek ilişkiler kuruyoruz.</h2>\n        <p>Müvekkillerimizi iş ortaklarımız olarak görüyoruz. Tüm müvekkillerimizin stratejik hedeflerinin ve başarılarının neyi gerektirdiğini derinlemesine anlayarak, onlarla uzun vadeli ve işbirliğine dayalı ilişki kurmayı hedefliyoruz.</p>   \n      </div>\n    </div>\n\n          <div class=\"col-sm-4\">\n      <div class=\"service-box\">\n        \n        <h2><i class=\"fa fa-long-arrow-right\"></i>Vatandaşlık Hukuku</h2>\n        <p>Vatandaşlık ilişkileri bağlamında hukuki problemlerle yüzleşmiş olan müvekkillerin hak ve menfaatlerinin korunması yönünde gereken adımları atmaktayız.</p>  \n         <div class=\"col-sm-12 text-right\">\n      <a href=\"tr/hizmetlerimiz/vatandaslik-hukuku\"><button class=\"btn minibutton bg-blue\">Devamını Oku</button></a>\n    </div> \n      </div>\n    </div>\n\n\n\n          <div class=\"col-sm-4\">\n      <div class=\"service-box\">\n        \n        <h2><i class=\"fa fa-long-arrow-right\"></i>Uzman Kadro</h2>\n        <p>Hukuk Bürosu olarak çalışmalarımızın temeli köklü değerlerimiz ve her biri kendi sahasında derin akademik bilgi birikimi ve iş tecrübesine sahip avukatlar ve  danışmanları ile birlikte müvekkillerine hizmet veriyoruz.</p>  \n      </div>\n    </div>\n\n  </div>\n</div>\n\n\n\n\n\n\n\n\n\n<div class=\"container-full\">\n\n      <img src=\"orta.jpg\" alt=\"Business Coach\" style=\"width: 100% !important;\">\n</div>\n\n<section class=\"section section-lg bg-primary\">\n        <div class=\"container-urun\">\n          <div class=\"row row-10 justify-content-lg-between\">\n            <div class=\"col-sm-5\"> \n              <h2 class=\"h-blue\">Güven ve Çözüm Odaklı<br>Hukuki Hizmet</h2>  \n              <p>• Stratejik ve etkin dava takibi<br>\n• Uyuşmazlıkların önleyici danışmanlık ile çözümü <br>\n• Hızlı iletişim ve şeffaf bilgilendirme <br>\n• Tam zamanlı destek ve titiz dosya yönetimi</p><br>\n \n<h3>Vizyonumuz</h3><p>\nMüvekkillerimizin karşılaştığı hukuki sorunları yalnızca çözüme kavuşturmakla kalmayıp, aynı zamanda haklarını kararlılıkla ve stratejik bir biçimde savunarak uzun vadeli güven ilişkileri kurmak.</p>\n <br>\n            </div>\n              <div class=\"col-sm-1\">\n              \t   <br>\n                </div>\n            <div class=\"col-sm-6\">\n              <p class=\"small\">Adil Hukuk Danışmanlık Bürosu olarak, müvekkillerimize hak ettikleri nitelikli ve güvenilir hukuki hizmeti sunmayı temel ilkemiz kabul ediyoruz.</p>\n              <p>Kurulduğumuz günden bu yana, yalnızca hukuk alanında değil, aynı zamanda insan ilişkilerinde de güven temelli bir yaklaşımı benimsiyoruz.</p>  <br>  <br><br>\n\n           \n                <div class=\"col-sm-2\"><img class=\"img-circle\" src=\"person-01-80x80.jpg\" alt=\"\" width=\"80\" height=\"80\">\n                </div>\n\n                <div class=\"col-sm-8\">\n                  <h3 class=\"h4\">Ekibimiz</h3>\n                  <p class=\"small mt-2\">Seçkin avukat kadromuz ve alanında deneyimli idari personelimiz ile birlikte çalışıyoruz.\n\n</p>\n                </div> \n\n                  <div class=\"col-sm-12\">\n         <br>\n <a href=\"tr/ekibimiz\"> <button class=\"btn btn-custom bg-blue\">Ekibimiz</button></a>    <a href=\"tr/hakkimizda\"><button class=\"btn btn-custom bg-blue\" style=\"margin-left: 25px;\">Hakkımızda</button></a>\n                </div> \n  </div>\n\n\n              </div><br>\n     \n            </div>\n          \n        \n      </section>\n\n \n\n\n<div class=\"container-full full1 back\"><div class=\"container-urun\"><div class=\"row\"> <div class=\"col-xs-12 col-sm-12 text-center\"><br><br><br>\n <h2>Sıkça Sorulan Sorular</h2>\n </div>\n\t<div class=\"col-xs-12 col-sm-12\"><hr></div><div class=\"col-xs-12 col-sm-12\"><div class=\"panel panel-default\"><div class=\"panel-heading accordion-toggle question-toggle collapsed\" data-toggle=\"collapse\" data-parent=\"#faqAccordion\" data-target=\"#question1325\"><p class=\"panel-title\">Soru 1</p></div><div id=\"question1325\" class=\"panel-collapse collapse\"><div class=\"panel-body\"><p>Cevap 1</p></div>\n</div></div><div class=\"panel panel-default\"><div class=\"panel-heading accordion-toggle question-toggle collapsed\" data-toggle=\"collapse\" data-parent=\"#faqAccordion\" data-target=\"#question1326\"><p class=\"panel-title\">Soru 2</p></div><div id=\"question1326\" class=\"panel-collapse collapse\"><div class=\"panel-body\"><p>Cevap 2</p></div>\n</div></div><div class=\"panel panel-default\"><div class=\"panel-heading accordion-toggle question-toggle collapsed\" data-toggle=\"collapse\" data-parent=\"#faqAccordion\" data-target=\"#question1327\"><p class=\"panel-title\">Soru 3</p></div><div id=\"question1327\" class=\"panel-collapse collapse\"><div class=\"panel-body\"><p>Cevap 3</p></div>\n</div></div></div>      \n<br><br>\n</div></div></div>\n\n<br><br><br>\n<script>(function(a){if(typeof define===\"function\"&&define.amd&&define.amd.jQuery){define([\"jquery\"],a)}else{if(typeof module!==\"undefined\"&&module.exports){a(require(\"jquery\"))}else{a(jQuery)}}}(function(f){var y=\"1.6.15\",p=\"left\",o=\"right\",e=\"up\",x=\"down\",c=\"in\",A=\"out\",m=\"none\",s=\"auto\",l=\"swipe\",t=\"pinch\",B=\"tap\",j=\"doubletap\",b=\"longtap\",z=\"hold\",E=\"horizontal\",u=\"vertical\",i=\"all\",r=10,g=\"start\",k=\"move\",h=\"end\",q=\"cancel\",a=\"ontouchstart\" in window,v=window.navigator.msPointerEnabled&&!window.navigato